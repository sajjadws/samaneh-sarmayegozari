model Session {
    id        String   @id
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    token     String   @unique
    expiresAt DateTime @db.DateTime(3)
    ipAddress String?
    userAgent String?
    createdAt DateTime @db.DateTime(3)
    updatedAt DateTime @db.DateTime(3)

    @@index([userId], map: "session_userId_idx")
    @@map("session")
}

model Account {
    id                    String    @id
    user                  User      @relation(fields: [userId], references: [id])
    userId                String
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    accessTokenExpiresAt  DateTime? @db.DateTime(3)
    refreshTokenExpiresAt DateTime? @db.DateTime(3)
    scope                 String?
    idToken               String?
    password              String?
    createdAt             DateTime  @db.DateTime(3)
    updatedAt             DateTime  @db.DateTime(3)

    @@index([userId], map: "account_userId_idx")
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime @db.DateTime(3)
    createdAt  DateTime @db.DateTime(3)
    updatedAt  DateTime @db.DateTime(3)

    @@index([identifier], map: "verification_identifier_idx")
    @@map("verification")
}
