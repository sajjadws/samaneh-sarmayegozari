model UserUtilities {
    id           String  @id
    firstName    String
    lastName     String
    nationalCode String? @unique @db.VarChar(10)
    avatar       String  @default("/public/media/images/profile.jpg")
    userId       String  @unique
    user         User    @relation(fields: [userId], references: [id])
}
