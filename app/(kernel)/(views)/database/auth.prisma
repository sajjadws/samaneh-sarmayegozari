model Session {
    id        String   @id
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime
    updatedAt DateTime

    @@index([userId])
}

model Account {
    id                    String    @id
    userId                String
    user                  User      @relation(fields: [userId], references: [id])
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    idToken               String?
    password              String?
    createdAt             DateTime
    updatedAt             DateTime

    @@index([userId])
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime
    updatedAt  DateTime

    @@index([identifier])
}
