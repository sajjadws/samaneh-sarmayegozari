model User {
    id                  String           @id @default(cuid())
    name                String?
    image               String?
    email               String?          @unique
    emailVerified       Boolean          @default(false)
    phoneNumber         String?          @unique
    phoneNumberVerified Boolean          @default(false)
    username            String?          @unique
    displayUsername     String?
    roleId              String?
    role                Role?            @relation(fields: [roleId], references: [id])
    status              UserStatus       @default(ACTIVE)
    wallet              Wallet?
    userInformation     UserInformation?
    projects            Project[]
    sessions            Session[]
    accounts            Account[]
    teamProjects        TeamProject[]
    userPermission      UserPermission[] @relation("userPermissions")
    assignedPermissions UserPermission[] @relation("assignedPermissions")
    createdAt           DateTime         @default(now())
    updatedAt           DateTime         @updatedAt
}

model UserInformation {
    id           String   @id
    firstName    String
    lastName     String
    nationalCode String?  @unique @db.VarChar(10)
    avatar       String   @default("/public/media/images/profile.jpg")
    userId       String   @unique
    user         User     @relation(fields: [userId], references: [id])
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

enum UserStatus {
    ACTIVE
    DEACTIVE
    SUSPENSE
}
